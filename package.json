{
  "name": "portent-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:browser": "pnpm --filter @portent/core check:browser",
    "check": "pnpm typecheck && pnpm test && pnpm check:browser",
    "manual": "node manual/build.mjs",
    "build:guidance": "node scripts/build-guidance.mjs"
  },
  "devDependencies": {
    "@portent/core": "workspace:*",
    "@types/node": "^26.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0",
    "@portent/content-generic": "workspace:*",
    "@portent/content": "workspace:*"
  },
  "license": "MIT"
}

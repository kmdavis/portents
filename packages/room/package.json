{
  "name": "@portents/room",
  "version": "0.0.0",
  "description": "Experimental transport-neutral room coordination for Portents. In-process only; not a hosted multiplayer server.",
  "keywords": [
    "rpg",
    "ttrpg",
    "multiplayer",
    "turns"
  ],
  "license": "MIT",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portents.git",
    "directory": "packages/room"
  },
  "homepage": "https://github.com/kmdavis/portents/tree/main/packages/room#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@portents/core": "workspace:*"
  },
  "devDependencies": {
    "@portents/core": "workspace:*"
  }
}

{
  "name": "@portents/setting-greywater",
  "version": "0.0.0",
  "description": "A small original Portents setting used to prove packaged Markdown resources and raster maps with pins.",
  "keywords": [
    "rpg",
    "ttrpg",
    "setting",
    "portents"
  ],
  "license": "CC0-1.0",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portents.git",
    "directory": "packages/setting-greywater"
  },
  "homepage": "https://github.com/kmdavis/portents/tree/main/packages/setting-greywater#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "resources",
    "maps",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./maps/*": "./maps/*"
  },
  "scripts": {
    "build": "node scripts/build-resources.mjs --check && tsc -p tsconfig.build.json",
    "build:resources": "node scripts/build-resources.mjs",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@portents/core": "workspace:*"
  },
  "devDependencies": {
    "@portents/core": "workspace:*"
  }
}

{
  "name": "@portents/content",
  "version": "0.0.0",
  "description": "Everything most tables need: the generic content pack plus the packs for systems in common use. Install this unless you want to pick packs by hand.",
  "keywords": [
    "rpg",
    "ttrpg",
    "solo",
    "content",
    "tables",
    "decks"
  ],
  "license": "CC-BY-4.0 AND CC0-1.0",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portents.git",
    "directory": "packages/content"
  },
  "homepage": "https://github.com/kmdavis/portents/tree/main/packages/content#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@portents/core": "workspace:*"
  },
  "dependencies": {
    "@portents/content-generic": "workspace:*",
    "@portents/content-dnd": "workspace:*",
    "@portents/content-pf": "workspace:*"
  },
  "devDependencies": {
    "@portents/core": "workspace:*"
  }
}

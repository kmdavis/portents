{
  "name": "@portents/web",
  "version": "0.0.0",
  "description": "Browser and edge integration for Portents: a storage-agnostic session facade over the engine. No UI.",
  "keywords": [
    "rpg",
    "ttrpg",
    "solo",
    "browser"
  ],
  "license": "MIT",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portents.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/kmdavis/portents/tree/main/packages/web#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "peerDependencies": {
    "@portents/content": "workspace:*",
    "@portents/core": "workspace:*",
    "@portents/guidance": "workspace:*"
  },
  "devDependencies": {
    "@portents/content": "workspace:*",
    "@portents/core": "workspace:*",
    "fake-indexeddb": "^6.2.5",
    "@portents/guidance": "workspace:*"
  }
}

{
  "name": "@portent/content-pf",
  "version": "0.0.0",
  "description": "Content shaped for the Pathfinder-style d20 systems: three-action combat, degrees of success, hero points. Original writing, CC0.",
  "keywords": [
    "rpg",
    "ttrpg",
    "solo",
    "content",
    "pf2e"
  ],
  "license": "CC0-1.0",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portent.git",
    "directory": "packages/content-pf"
  },
  "homepage": "https://github.com/kmdavis/portent/tree/main/packages/content-pf#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "guidance"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@portent/core": "workspace:*"
  },
  "devDependencies": {
    "@portent/content-generic": "workspace:*",
    "@portent/core": "workspace:*"
  }
}

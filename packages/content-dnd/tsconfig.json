{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		"noEmit": true,
		// Resolve @portents/* to their sources through the same "development" export
		// condition the test runner uses. This replaced a `paths` mapping that
		// pointed at ../lib/src, a directory the packages/ move deleted -- so the
		// mapping was dead and resolution silently fell through to dist.
		"customConditions": ["development"]
	},
	"include": ["src/**/*.ts"]
}

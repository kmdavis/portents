{
  "name": "@portent/content-dnd",
  "version": "0.0.0",
  "description": "Content for fifth-edition d20 fantasy: both printings, with tables adapted from the System Reference Documents under CC-BY-4.0.",
  "keywords": [
    "rpg",
    "ttrpg",
    "solo",
    "content",
    "5e",
    "srd"
  ],
  "license": "CC-BY-4.0 AND CC0-1.0",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portent.git",
    "directory": "packages/content-dnd"
  },
  "homepage": "https://github.com/kmdavis/portent/tree/main/packages/content-dnd#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./2014": {
      "development": "./src/2014/index.ts",
      "types": "./dist/2014/index.d.ts",
      "default": "./dist/2014/index.js"
    },
    "./2024": {
      "development": "./src/2024/index.ts",
      "types": "./dist/2024/index.d.ts",
      "default": "./dist/2024/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/notice.mjs",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "notice": "node scripts/notice.mjs"
  },
  "peerDependencies": {
    "@portent/core": "workspace:*"
  },
  "devDependencies": {
    "@portent/core": "workspace:*",
    "@portent/content-generic": "workspace:*"
  }
}

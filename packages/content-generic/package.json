{
  "name": "@portent/content-generic",
  "version": "0.0.0",
  "description": "Generic solo-RPG content: decks, tables and dungeon tiles that work in any d20-ish fantasy game. The fallback every other content pack overrides.",
  "keywords": [
    "rpg",
    "ttrpg",
    "dungeon",
    "tiles",
    "tables",
    "content"
  ],
  "license": "MIT",
  "author": "Kevan Davis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmdavis/portent.git",
    "directory": "packages/content-generic"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --conditions=development --test 'src/**/*.test.ts'",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@portent/core": "workspace:^"
  },
  "devDependencies": {
    "@portent/core": "workspace:*",
    "typescript": "^5.7.0"
  }
}
